# ==============================================================================
# VRK SOLUTIONS - PRODUCTION & DEVELOPMENT ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.local for local development.
# In production, set these variables in your hosting environment (Vercel, AWS, etc.)
# NEVER commit real secret keys into version control.

# Core Site URL
NEXT_PUBLIC_SITE_URL=https://vrksolutions.in

# Sanity CMS Configuration
# Required to connect to your remote Sanity studio/dataset.
# If omitted or unconfigured, the application runs gracefully using its built-in
# verified fallback data store with identical schemas and types.
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-03-01
SANITY_API_READ_TOKEN=your_sanity_read_preview_token

# Transactional Email Provider (Resend)
# Used for server-side delivery of Contact, Quotation, and Consultation enquiries.
# If omitted in development, submissions log safely to standard console with clear setup guidance.
RESEND_API_KEY=re_your_resend_api_key_here
CONTACT_RECEIVER_EMAIL=info@vrksolutions.in
CONTACT_SENDER_EMAIL=VRK Solutions <notifications@vrksolutions.in>
